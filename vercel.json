{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/replica",
      "destination": "/replica.html"
    },
    {
      "source": "/replica/",
      "destination": "/replica.html"
    },
    {
      "source": "/((?!api/|.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/chat.mjs": {
      "supportsCancellation": true,
      "maxDuration": 60
    }
  }
}
