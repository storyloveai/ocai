  {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "turn_request.schema.json",
    "title": "Turn Request v0.2",
    "description": "前端每轮发给后端的内容。turn_id 由前端生成，用于幂等：同一个 turn_id 重发时，后端返回第一次的结果，不重复执行。",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "turn_id",
      "input"
    ],
    "properties": {
      "turn_id": {
        "type": "string",
        "minLength": 8
      },
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "enum": [
              "typed",
              "suggestion"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 500,
            "description": "mode=typed 时必填"
          },
          "suggestion_id": {
            "type": "string",
            "description": "mode=suggestion 时必填，取自上一轮返回的 suggestions[].id"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "typed"
                }
              }
            },
            "then": {
              "required": [
                "text"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "suggestion"
                }
              }
            },
            "then": {
              "required": [
                "suggestion_id"
              ]
            }
          }
        ]
      }
    }
  }
]