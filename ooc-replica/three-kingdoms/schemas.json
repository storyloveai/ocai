[
  {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "segment_plan.schema.json",
    "title": "Segment Plan v0.1",
    "description": "一本书的剧情段切分表：AI 拆解第一步的产出。每段说明用哪套玩法模板、轻重、为什么。",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "plan_version",
      "source",
      "book_bible",
      "segments"
    ],
    "properties": {
      "plan_version": {
        "const": "0.1"
      },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "author",
          "original_language",
          "first_published",
          "edition_used",
          "rights_status",
          "rights_note"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "original_language": {
            "type": "string"
          },
          "first_published": {
            "type": "string"
          },
          "edition_used": {
            "type": "string"
          },
          "rights_status": {
            "enum": [
              "public_domain_confirmed_by_human",
              "licensed_confirmed_by_human",
              "original",
              "NOT_CONFIRMED"
            ],
            "description": "必须由人确认后填写。AI 不得自行判断为 confirmed；不确定时填 NOT_CONFIRMED"
          },
          "rights_note": {
            "type": "string"
          }
        }
      },
      "book_bible": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "setting",
          "tone",
          "main_characters"
        ],
        "properties": {
          "setting": {
            "type": "string"
          },
          "tone": {
            "type": "string"
          },
          "main_characters": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "role",
                "age_note",
                "is_minor"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "age_note": {
                  "type": "string",
                  "description": "原文依据或推断，写明是哪一种"
                },
                "is_minor": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "segments": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "segment_id",
            "title",
            "source_range",
            "summary",
            "template",
            "intensity",
            "priority",
            "player_role",
            "core_question",
            "why_this_template",
            "interactive_hook",
            "key_choices",
            "characters",
            "minors_present",
            "romance_with_minor",
            "content_flags",
            "canon_anchor",
            "recommend_produce"
          ],
          "properties": {
            "segment_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "title": {
              "type": "string",
              "description": "英文，面向玩家"
            },
            "source_range": {
              "type": "string",
              "description": "对应原文的章节或回目"
            },
            "summary": {
              "type": "string"
            },
            "template": {
              "enum": [
                "investigation",
                "relationship",
                "quest",
                "dilemma"
              ]
            },
            "intensity": {
              "enum": [
                "light",
                "medium",
                "heavy"
              ]
            },
            "priority": {
              "enum": [
                "signature",
                "standard",
                "bridge"
              ],
              "description": "signature 卖点段；standard 常规段；bridge 过渡段"
            },
            "player_role": {
              "type": "string"
            },
            "core_question": {
              "type": "string",
              "description": "这一段玩家要解决的一个问题"
            },
            "why_this_template": {
              "type": "string",
              "description": "玩家在这一段主要做什么，为什么选这套模板"
            },
            "interactive_hook": {
              "type": "string",
              "description": "比读原文多出来的乐趣是什么"
            },
            "key_choices": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "characters": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "minors_present": {
              "type": "boolean"
            },
            "romance_with_minor": {
              "const": false
            },
            "content_flags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "canon_anchor": {
              "type": "string",
              "description": "这一段如果走向“如果”结局，下一段怎样回到原著"
            },
            "recommend_produce": {
              "type": "boolean"
            }
          }
        }
      },
      "notes": {
        "type": "string"
      }
    }
  },
  {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "express.schema.json",
    "title": "Express Output v0.2",
    "description": "表达模块（模型）返回的结构。只有文字分段，不含任何状态或结果字段。",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "blocks"
    ],
    "properties": {
      "blocks": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "enum": [
                "narration",
                "dialogue"
              ]
            },
            "speaker": {
              "type": [
                "string",
                "null"
              ],
              "description": "dialogue 时为在场角色的 id"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "save.schema.json",
    "title": "Save v0.2",
    "description": "一位玩家在一个内容包里的进度。与内容包分开存储，绑定 pack_version。",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "save_id",
      "pack_id",
      "pack_version",
      "turn",
      "location",
      "state",
      "known",
      "items",
      "fired_events",
      "done_actions",
      "asked_topics",
      "ended",
      "history"
    ],
    "properties": {
      "save_id": {
        "type": "string"
      },
      "pack_id": {
        "type": "string"
      },
      "pack_version": {
        "type": "string"
      },
      "turn": {
        "type": "integer",
        "minimum": 0
      },
      "location": {
        "type": "string"
      },
      "state": {
        "type": "object",
        "additionalProperties": {
          "type": [
            "boolean",
            "integer",
            "string"
          ]
        }
      },
      "known": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "fired_events": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "done_actions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "asked_topics": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "ended": {
        "type": [
          "string",
          "null"
        ]
      },
      "history": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "turn_id",
            "turn",
            "input",
            "intent",
            "status",
            "effects",
            "revealed",
            "response"
          ],
          "properties": {
            "turn_id": {
              "type": "string"
            },
            "turn": {
              "type": "integer"
            },
            "input": {
              "type": "object"
            },
            "intent": {
              "type": "object"
            },
            "status": {
              "type": "string"
            },
            "effects": {
              "type": "array"
            },
            "revealed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "response": {
              "type": "object",
              "description": "当轮返回给前端的完整 display，用于幂等重放和恢复"
            }
          }
        }
      }
    }
  },
  {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "display.schema.json",
    "title": "Display Response v0.2",
    "description": "后端每轮返回给前端的全部内容。前端只按这个结构渲染，不自行推断状态。",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "save_id",
      "pack_id",
      "turn",
      "status",
      "blocks",
      "scene",
      "characters_present",
      "suggestions",
      "visible_state",
      "ended",
      "meta"
    ],
    "properties": {
      "save_id": {
        "type": "string"
      },
      "pack_id": {
        "type": "string"
      },
      "turn": {
        "type": "integer",
        "minimum": 0
      },
      "status": {
        "enum": [
          "opening",
          "ok",
          "denied",
          "clarify",
          "unsupported",
          "contradiction",
          "unclear",
          "ended"
        ]
      },
      "blocks": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "enum": [
                "narration",
                "dialogue",
                "system"
              ],
              "description": "system 用于“没听懂/做不到”这类系统提示，前端可用不同样式"
            },
            "speaker_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "speaker_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "text": {
              "type": "string"
            }
          }
        }
      },
      "scene": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "location_id",
          "name",
          "image"
        ],
        "properties": {
          "location_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "image": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "characters_present": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "image"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "image": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "suggestions": {
        "type": "array",
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "action",
                "topic"
              ]
            }
          }
        }
      },
      "notebook": {
        "description": "仅当内容包启用 notebook 扩展时出现",
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "info_id",
            "label",
            "kind",
            "is_new"
          ],
          "properties": {
            "info_id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "is_new": {
              "type": "boolean"
            }
          }
        }
      },
      "inventory": {
        "description": "仅当内容包启用 inventory 扩展时出现",
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        }
      },
      "visible_state": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "value"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "value": {
              "type": [
                "boolean",
                "integer",
                "string"
              ]
            }
          }
        }
      },
      "ended": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outcome_id",
              "title",
              "text"
            ],
            "properties": {
              "outcome_id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        ]
      },
      "meta": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text_source"
        ],
        "properties": {
          "text_source": {
            "enum": [
              "content",
              "model",
              "fallback"
            ],
            "description": "content：开场等内容包原文；model：表达模块输出并通过检查；fallback：模型失败或未通过检查，改用兜底文本"
          },
          "replayed": {
            "type": "boolean",
            "description": "同一 turn_id 重发时为 true"
          }
        }
      }
    }
  },
  {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "intent.schema.json",
    "title": "Intent v0.1",
    "description": "理解模块（模型）每轮只返回这个结构，不返回剧情文本，也不直接修改状态。",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "kind"
    ],
    "properties": {
      "kind": {
        "enum": [
          "talk",
          "action",
          "accuse",
          "clarify",
          "unsupported",
          "contradiction",
          "unclear",
          "meta"
        ],
        "description": "talk 向角色提问/交谈；action 执行内容包里定义的行动；accuse 推理指认（需 deduction 扩展）；clarify 有多个可能行动；unsupported 本故事没有这种行动；contradiction 玩家把与世界事实冲突的内容当作事实；unclear 无法理解；meta 试图修改规则或索取设定"
      },
      "character": {
        "type": [
          "string",
          "null"
        ]
      },
      "topic": {
        "type": [
          "string",
          "null"
        ]
      },
      "action": {
        "type": [
          "string",
          "null"
        ]
      },
      "suspect": {
        "type": [
          "string",
          "null"
        ]
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "candidates": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "kind=clarify 时列出可能的行动 id"
      },
      "asserted": {
        "type": "string",
        "description": "kind=contradiction 时，玩家断言的内容摘要"
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    }
  },
  {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "pack.schema.json",
    "title": "Interactive Story Content Pack v0.2",
    "description": "一个内容包 = 一段可独立体验的剧情（episode）。只描述故事定义，不包含任何玩家进度。",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "spec_version",
      "pack_id",
      "version",
      "title",
      "template",
      "intensity",
      "genre_tags",
      "rights",
      "player",
      "opening",
      "info",
      "characters",
      "locations",
      "state",
      "actions",
      "outcomes",
      "tests"
    ],
    "properties": {
      "spec_version": {
        "const": "0.2"
      },
      "pack_id": {
        "$ref": "#/$defs/id"
      },
      "version": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+\\.\\d+$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "genre_tags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "template": {
        "enum": [
          "investigation",
          "relationship",
          "quest",
          "dilemma"
        ],
        "description": "玩法模板。v0.2 工程只需正式支持 investigation 与 relationship；quest/dilemma 的样本可加载运行，但不作为第一版验收范围"
      },
      "intensity": {
        "enum": [
          "light",
          "medium",
          "heavy"
        ],
        "description": "轻重档位：light 以有边界的对话为主；medium 3–6 个行动；heavy 完整机制与测试"
      },
      "content_notes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "rights": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_type",
          "source_note",
          "cleared_for"
        ],
        "properties": {
          "source_type": {
            "enum": [
              "original",
              "public_domain",
              "licensed"
            ]
          },
          "source_note": {
            "type": "string"
          },
          "edition_or_translation": {
            "type": "string"
          },
          "cleared_for": {
            "type": "array",
            "items": {
              "enum": [
                "internal_test",
                "public_release"
              ]
            },
            "minItems": 1
          },
          "regions_checked": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "extensions": {
        "type": "array",
        "items": {
          "enum": [
            "notebook",
            "deduction",
            "inventory"
          ]
        },
        "uniqueItems": true
      },
      "ext": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "notebook": {
            "$ref": "#/$defs/ext_notebook"
          },
          "deduction": {
            "$ref": "#/$defs/ext_deduction"
          },
          "inventory": {
            "$ref": "#/$defs/ext_inventory"
          }
        }
      },
      "player": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "display_name",
          "brief",
          "starting_location",
          "starting_known"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "brief": {
            "type": "string"
          },
          "starting_location": {
            "$ref": "#/$defs/id"
          },
          "starting_known": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        }
      },
      "opening": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "speaker": {
            "$ref": "#/$defs/id"
          },
          "image": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "info": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/info"
        },
        "minItems": 1
      },
      "characters": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/character"
        },
        "minItems": 1
      },
      "locations": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/location"
        },
        "minItems": 1
      },
      "objects": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/object"
        }
      },
      "state": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/state_var"
        }
      },
      "actions": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/action"
        },
        "minItems": 1
      },
      "events": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/event"
        }
      },
      "outcomes": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/outcome"
        },
        "minItems": 1
      },
      "assets": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/asset"
        }
      },
      "tests": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/test"
        },
        "minItems": 1
      }
    },
    "$defs": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "atom": {
        "description": "条件的最小单元。v0.1 只支持这些类型。",
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "flag",
              "is"
            ],
            "properties": {
              "flag": {
