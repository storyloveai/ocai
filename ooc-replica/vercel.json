{
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/seven-nights/:episode(ep[1-3])",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|assets/|app\\.js|style\\.css|data\\.json).*)",
      "destination": "/index.html"
    }
  ],
  "fluid": true,
  "functions": {
    "api/chat.js": {
      "maxDuration": 180
    },
    "api/image.js": {
      "maxDuration": 120
    },
    "api/sanguo.js": {
      "includeFiles": "server/{sanguo-*,xichuan-*}"
    }
  },
  "buildCommand": "npm run build && npm run check",
  "headers": [
    {
      "source": "/chat/sn-julian",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "origin"
        }
      ]
    },
    {
      "source": "/assets/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/assets/xichuan/index.html",
      "missing": [
        {
          "type": "query",
          "key": "site",
          "value": "1"
        }
      ],
      "destination": "/play/xichuan",
      "permanent": false
    },
    {
      "source": "/pilot/seven-nights",
      "destination": "/seven-nights/ep1",
      "permanent": false
    },
    {
      "source": "/pilot/seven-nights/:episode(ep[1-3])",
      "destination": "/seven-nights/:episode",
      "permanent": false
    }
  ]
}
