# Firebase Web app public configuration (not Admin or service-account keys)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Enable only after Apple provider credentials are configured in Firebase
FIREBASE_APPLE_ENABLED=false

# Server-only Firebase Admin service account for verified auth and atomic wallets.
# Use a service account belonging to FIREBASE_PROJECT_ID with Auth read and Firestore access.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Exact HTTPS origin of THIS replica deployment (not the original root application).
APP_URL=
# All Stripe values must belong to the same account and mode.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_200=
STRIPE_PRICE_2500=
STRIPE_PRICE_5000=
STRIPE_LIVE_ENABLED=false
# Optional Production-only overrides; do not set these on sandbox Preview deployments.
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
