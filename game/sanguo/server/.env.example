# 复制为环境变量使用（server.js 不读 .env 文件，请在终端 export 或用你习惯的方式注入）
# —— 方案 A：Claude ——
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_QUICK=claude-haiku-5-5      # 理解/表达默认用的快速模型
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# —— 方案 B：任意 OpenAI 兼容接口（如通义、DeepSeek、自建网关）——
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=
# —— 其他 ——
# PORT=8787
# LLM_TIMEOUT_MS=30000
# MAX_TOKENS=1024
# CREATOR_VIEW=1                            # 本地试玩时打开创作者视图；部署到公网不要设置
